{%- comment -%} Params: collection (object or blank), limit, filter (tab label, used only for the built-in sample products) {%- endcomment -%}
<div class="carousel" data-carousel>
  <button type="button" class="carousel__btn carousel__btn--prev" data-carousel-prev aria-label="Previous">{% render 'icon', name: 'arrow' %}</button>
  <div class="carousel__track" data-carousel-track>
    {%- if collection != blank and collection.products_count > 0 -%}
      {%- for product in collection.products limit: limit -%}
        <div class="carousel__item">{% render 'product-card', product: product %}</div>
      {%- endfor -%}
    {%- else -%}
      {%- liquid
        assign demo_handles = 'hair-oil|hair-shampoo|joints-oil|body-wash|hand-wash' | split: '|'
        assign demo_titles = 'Unify Organica Hair Oil|Unify Organica Hair Shampoo|Unify Organica Joints Oil|Unify Organica Body Wash|Unify Organica Hand Wash' | split: '|'
        assign demo_types = 'Hair Oil|Shampoo|Joints Oil|Body Wash|Hand Wash' | split: '|'
        assign demo_groups = 'hair care|hair care|joint care|body care|body care' | split: '|'
        assign demo_prices = '1200|1100|1500|950|650' | split: '|'
        assign demo_compares = '1500|0|1800|0|0' | split: '|'
        assign shown = 0
      -%}
      {%- for h in demo_handles -%}
        {%- assign i = forloop.index0 -%}
        {%- if filter == blank or demo_groups[i] == filter or filter contains 'all' -%}
          {%- if shown < limit -%}
            {%- assign shown = shown | plus: 1 -%}
            {%- assign p = demo_prices[i] | times: 100 -%}
            {%- assign c = demo_compares[i] | times: 100 -%}
            {%- assign img = 'product-' | append: h | append: '.jpg' | asset_url -%}
            <div class="carousel__item">{% render 'product-card', placeholder_title: demo_titles[i], placeholder_type: demo_types[i], placeholder_price: p, placeholder_compare: c, placeholder_image: img %}</div>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  </div>
  <button type="button" class="carousel__btn carousel__btn--next" data-carousel-next aria-label="Next">{% render 'icon', name: 'arrow' %}</button>
</div>
