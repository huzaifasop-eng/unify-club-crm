{%- comment -%} Params: collection (object or blank), limit, seed (0-7, shifts placeholder set) {%- endcomment -%}
<div class="carousel" data-carousel>
  <button type="button" class="carousel__btn carousel__btn--prev" data-carousel-prev aria-label="Previous">{% render 'icon', name: 'arrow' %}</button>
  <div class="carousel__track" data-carousel-track>
    {%- if collection != blank and collection.products_count > 0 -%}
      {%- for product in collection.products limit: limit -%}
        <div class="carousel__item">{% render 'product-card', product: product %}</div>
      {%- endfor -%}
    {%- else -%}
      {%- assign names = 'Rosemary & Onion Growth Oil|Hibiscus Gentle Shampoo|Oat & Honey Body Wash|Neem & Tulsi Hand Wash|Shea Butter Hand & Feet Cream|Argan Shine Hair Serum|Aloe Mint Scalp Shampoo|Complete Ritual Gift Set|Amla & Bhringraj Hair Oil|Lavender & Aloe Hand Wash|Peppermint Foot Repair Cream|Hair Growth Duo' | split: '|' -%}
      {%- assign types = 'Hair Oil|Shampoo|Body Wash|Hand Wash|Hand & Feet Cream|Hair Oil|Shampoo|Gift Set|Hair Oil|Hand Wash|Hand & Feet Cream|Gift Set' | split: '|' -%}
      {%- assign prices = '2200|1800|1600|950|1400|2500|1800|6500|1900|950|1500|3600' | split: '|' -%}
      {%- assign compares = '2600|0|1900|0|1650|0|2100|7500|0|1100|0|4000' | split: '|' -%}
      {%- assign s = seed | default: 0 -%}
      {%- for n in (1..limit) -%}
        {%- assign i = n | minus: 1 | plus: s | modulo: 12 -%}
        {%- assign p = prices[i] | times: 100 -%}
        {%- assign c = compares[i] | times: 100 -%}
        <div class="carousel__item">{% render 'product-card', placeholder_title: names[i], placeholder_type: types[i], placeholder_price: p, placeholder_compare: c %}</div>
      {%- endfor -%}
    {%- endif -%}
  </div>
  <button type="button" class="carousel__btn carousel__btn--next" data-carousel-next aria-label="Next">{% render 'icon', name: 'arrow' %}</button>
</div>
