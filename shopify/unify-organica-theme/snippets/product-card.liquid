{%- comment -%}
  Params: product (object, optional), placeholder_title, placeholder_type, placeholder_price
{%- endcomment -%}
{%- if product != blank -%}
  {%- liquid
    assign on_sale = false
    if product.compare_at_price > product.price
      assign on_sale = true
    endif
    assign first_available = product.selected_or_first_available_variant
  -%}
  <article class="card">
    <a href="{{ product.url }}" class="card__media" aria-label="{{ product.title | escape }}">
      {%- if product.featured_media -%}
        {{ product.featured_media | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300, 450, 600, 700', sizes: '(min-width: 990px) 25vw, 50vw', class: 'card__img', alt: product.featured_media.alt | default: product.title }}
        {%- if product.media[1] -%}
          {{ product.media[1] | image_url: width: 700 | image_tag: loading: 'lazy', class: 'card__img card__img--hover', alt: '' }}
        {%- endif -%}
      {%- else -%}
        <div class="card__art">{% render 'bottle-art', type: product.type, label: product.type %}</div>
      {%- endif -%}
      <div class="card__badges">
        {%- if product.available == false -%}
          <span class="badge badge--muted">Sold out</span>
        {%- elsif on_sale -%}
          <span class="badge badge--accent">Save {{ product.compare_at_price | minus: product.price | money_without_trailing_zeros }}</span>
        {%- endif -%}
        {%- if product.tags contains 'bestseller' -%}<span class="badge">Bestseller</span>{%- endif -%}
        {%- if product.tags contains 'new' -%}<span class="badge">New</span>{%- endif -%}
      </div>
    </a>
    <div class="card__body">
      {%- if product.type != blank -%}<p class="card__type">{{ product.type }}</p>{%- endif -%}
      <h3 class="card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
      <div class="card__foot">
        <p class="price">
          {%- if product.price_varies -%}<span class="price__from">From</span>{%- endif -%}
          <span class="price__now">{{ product.price | money }}</span>
          {%- if on_sale -%}<s class="price__was">{{ product.compare_at_price | money }}</s>{%- endif -%}
        </p>
        {%- if product.has_only_default_variant and product.available -%}
          {%- form 'product', product, class: 'card__quick', data-ajax-cart: '' -%}
            <input type="hidden" name="id" value="{{ first_available.id }}">
            <button type="submit" class="icon-btn icon-btn--solid" aria-label="Add {{ product.title | escape }} to bag">{% render 'icon', name: 'plus' %}</button>
          {%- endform -%}
        {%- else -%}
          <a href="{{ product.url }}" class="icon-btn icon-btn--solid" aria-label="Choose options for {{ product.title | escape }}">{% render 'icon', name: 'arrow' %}</a>
        {%- endif -%}
      </div>
    </div>
  </article>
{%- else -%}
  <article class="card card--placeholder">
    <div class="card__media"><div class="card__art">{% render 'bottle-art', type: placeholder_type, label: placeholder_type %}</div></div>
    <div class="card__body">
      <p class="card__type">{{ placeholder_type }}</p>
      <h3 class="card__title">{{ placeholder_title }}</h3>
      <div class="card__foot"><p class="price"><span class="price__now">{{ placeholder_price | default: 2400 | money }}</span></p></div>
    </div>
  </article>
{%- endif -%}
