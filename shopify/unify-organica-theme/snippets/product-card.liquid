{%- comment -%}
  Params: product (object, optional), or placeholder_title / placeholder_type / placeholder_price / placeholder_compare (cents) / placeholder_image (url)
{%- endcomment -%}
{%- liquid
  if product != blank
    assign price = product.price
    assign compare = product.compare_at_price
    assign title = product.title
    assign ptype = product.type
    assign url = product.url
  else
    assign price = placeholder_price | default: 200000
    assign compare = placeholder_compare | default: 0
    assign title = placeholder_title
    assign ptype = placeholder_type
    assign url = routes.all_products_collection_url
  endif
  assign pct = 0
  if compare > price
    assign pct = compare | minus: price | times: 100 | divided_by: compare | floor
  endif
-%}
<article class="card">
  <a href="{{ url }}" class="card__media" aria-label="{{ title | escape }}">
    {%- if product != blank and product.featured_media -%}
      {{ product.featured_media | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 990px) 22vw, 45vw', class: 'card__img', alt: product.featured_media.alt | default: title }}
      {%- if product.media[1] -%}
        {{ product.media[1] | image_url: width: 600 | image_tag: loading: 'lazy', class: 'card__img card__img--hover', alt: '' }}
      {%- endif -%}
    {%- elsif placeholder_image != blank -%}
      <img src="{{ placeholder_image }}" alt="{{ title | escape }}" class="card__img" loading="lazy" width="640" height="640">
    {%- else -%}
      <div class="card__art">{% render 'bottle-art', type: ptype, label: ptype %}</div>
    {%- endif -%}
  </a>
  <div class="card__badges">
    {%- if pct > 0 -%}<span class="badge badge--sale">Sale {{ pct }}%</span>{%- endif -%}
    {%- if product != blank and product.available == false -%}<span class="badge badge--muted">Sold out</span>{%- endif -%}
  </div>
  <div class="card__body">
    <h3 class="card__title"><a href="{{ url }}">{{ title }}</a></h3>
    <p class="price">
      {%- if compare > price -%}<s class="price__was">{{ compare | money }}</s>{%- endif -%}
      {%- if product != blank and product.price_varies -%}<span class="price__from">From</span>{%- endif -%}
      <span class="price__now{% if compare > price %} price__now--sale{% endif %}">{{ price | money }}</span>
    </p>
    {%- if product == blank -%}
      <a href="{{ url }}" class="btn btn--outline btn--block card__btn">Add to cart</a>
    {%- elsif product.available == false -%}
      <a href="{{ url }}" class="btn btn--outline btn--block card__btn">Notify me</a>
    {%- elsif product.has_only_default_variant -%}
      {%- form 'product', product, class: 'card__form', data-ajax-cart: '' -%}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button type="submit" class="btn btn--outline btn--block card__btn">Add to cart</button>
      {%- endform -%}
    {%- else -%}
      <a href="{{ url }}" class="btn btn--outline btn--block card__btn">Choose options</a>
    {%- endif -%}
  </div>
</article>
