{%- comment -%}
  Params: product (object), or placeholder_title / placeholder_subtitle / placeholder_price / placeholder_compare (cents) / placeholder_image (url)
{%- endcomment -%}
{%- liquid
  if product != blank
    assign price = product.price
    assign compare = product.compare_at_price
    assign title = product.title
    assign url = product.url
    assign subtitle = product.metafields.custom.subtitle.value
    if subtitle == blank
      assign head = product.description | slice: 0, 11
      if head == '<p><strong>'
        assign subtitle = product.description | split: '</strong>' | first | strip_html | strip
      else
        assign subtitle = product.type
      endif
    endif
    assign rating_count = product.metafields.reviews.rating_count.value | default: 0
  else
    assign price = placeholder_price | default: 100000
    assign compare = placeholder_compare | default: 0
    assign title = placeholder_title
    assign url = routes.all_products_collection_url
    assign subtitle = placeholder_subtitle
    assign rating_count = 0
  endif
  assign on_sale = false
  if compare > price
    assign on_sale = true
  endif
-%}
<article class="pcard">
  <a href="{{ url }}" class="pcard__media" aria-label="{{ title | escape }}">
    {%- if product != blank and product.featured_media -%}
      {{ product.featured_media | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 990px) 19vw, 45vw', class: 'pcard__img', alt: product.featured_media.alt | default: title }}
      {%- if product.media[1] -%}
        {{ product.media[1] | image_url: width: 600 | image_tag: loading: 'lazy', class: 'pcard__img pcard__img--hover', alt: '' }}
      {%- endif -%}
    {%- elsif placeholder_image != blank -%}
      <img src="{{ placeholder_image }}" alt="{{ title | escape }}" class="pcard__img" loading="lazy" width="700" height="700">
    {%- else -%}
      <div class="pcard__art">{% render 'bottle-art', type: subtitle, label: title %}</div>
    {%- endif -%}
    {%- if product != blank and product.available == false -%}
      <span class="tag tag--sale">Sold out</span>
    {%- elsif on_sale -%}
      <span class="tag tag--sale">Sale</span>
    {%- endif -%}
  </a>
  {%- if product != blank and product.available and product.has_only_default_variant -%}
    {%- form 'product', product, class: 'pcard__quick', data-ajax-cart: '' -%}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      <button type="submit" aria-label="Add {{ title | escape }} to cart">{% render 'icon', name: 'plus' %}</button>
    {%- endform -%}
  {%- endif -%}
  <div class="pcard__body">
    <h3 class="pcard__title"><a href="{{ url }}">{{ title }}</a></h3>
    {%- if subtitle != blank -%}<p class="pcard__sub">{{ subtitle }}</p>{%- endif -%}
    {%- if rating_count > 0 -%}
      {%- assign rating = product.metafields.reviews.rating.value.rating | round -%}
      <p class="pcard__rating"><span class="stars stars--dark">{%- for i in (1..5) -%}<span class="{% if i > rating %}off{% endif %}">{% render 'icon', name: 'star' %}</span>{%- endfor -%}</span> {{ rating_count }} Reviews</p>
    {%- endif -%}
    <p class="pcard__price">
      {%- if product != blank and product.price_varies -%}<span class="pcard__from">from</span>{%- endif -%}
      <span class="pcard__now">{{ price | money }}</span>
      {%- if on_sale -%}<s class="pcard__was">{{ compare | money }}</s>{%- endif -%}
    </p>
  </div>
</article>
