{%- if settings.whatsapp_number != blank -%}
  {%- assign wa = settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' -%}
  <a class="wa-float" href="https://wa.me/{{ wa }}?text={{ settings.whatsapp_message | url_encode }}" target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp">
    {% render 'icon', name: 'whatsapp' %}
  </a>
{%- endif -%}
