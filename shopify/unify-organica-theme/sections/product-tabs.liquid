<section class="section section--compact" data-tabs>
  <div class="page-width">
    {% render 'section-title', title: section.settings.heading %}
    {%- if section.blocks.size > 1 -%}
      <div class="tabs" role="tablist">
        {%- for block in section.blocks -%}
          <button type="button" role="tab" class="tab{% if forloop.first %} is-active{% endif %}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" data-tab="{{ forloop.index0 }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</button>
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- for block in section.blocks -%}
      <div class="tab-panel" role="tabpanel" data-panel="{{ forloop.index0 }}" {% unless forloop.first %}hidden{% endunless %}>
        {%- assign demo_filter = block.settings.label | downcase -%}
        {% render 'product-carousel', collection: block.settings.collection, limit: section.settings.limit, filter: demo_filter %}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Product tabs",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Winter essentials" },
    { "type": "range", "id": "limit", "label": "Products per tab", "min": 4, "max": 16, "step": 1, "default": 8 }
  ],
  "max_blocks": 5,
  "blocks": [
    { "type": "tab", "name": "Tab", "settings": [
      { "type": "text", "id": "label", "label": "Tab label", "default": "Hair care" },
      { "type": "collection", "id": "collection", "label": "Collection" }
    ]}
  ],
  "presets": [{ "name": "Product tabs", "blocks": [
    { "type": "tab", "settings": { "label": "Hair care" } },
    { "type": "tab", "settings": { "label": "Body care" } }
  ]}]
}
{% endschema %}
