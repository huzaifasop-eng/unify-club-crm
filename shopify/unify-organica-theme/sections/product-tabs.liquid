<section class="section" data-tabs>
  <div class="page-width">
    <h2 class="title-center">{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}<p class="subtitle-center">{{ section.settings.subheading }}</p>{%- endif -%}
    <div class="utabs" role="tablist">
      {%- for block in section.blocks -%}
        <button type="button" role="tab" class="utab{% if forloop.first %} is-active{% endif %}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" data-tab="{{ forloop.index0 }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</button>
      {%- endfor -%}
    </div>
    {%- for block in section.blocks -%}
      <div class="tab-panel" role="tabpanel" data-panel="{{ forloop.index0 }}" {% unless forloop.first %}hidden{% endunless %}>
        {%- assign demo_filter = block.settings.label | downcase -%}
        {%- assign more = routes.all_products_collection_url -%}
        {%- if block.settings.collection != blank -%}{%- assign more = block.settings.collection.url -%}{%- endif -%}
        {% render 'product-grid', collection: block.settings.collection, limit: section.settings.limit, filter: demo_filter, discover_url: more %}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Product tabs",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our best sellers" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Natural care you'll reach for every day" },
    { "type": "range", "id": "limit", "label": "Products per tab", "min": 2, "max": 12, "step": 1, "default": 4 }
  ],
  "max_blocks": 6,
  "blocks": [
    { "type": "tab", "name": "Tab", "settings": [
      { "type": "text", "id": "label", "label": "Tab label", "default": "Hair care" },
      { "type": "collection", "id": "collection", "label": "Collection" }
    ]}
  ],
  "presets": [{ "name": "Product tabs", "blocks": [{ "type": "tab" }] }]
}
{% endschema %}
