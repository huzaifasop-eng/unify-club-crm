<header class="header{% if section.settings.sticky %} header--sticky{% endif %}" data-header>
  <div class="page-width header__top">
    <div class="header__left">
      <details class="mobile-nav" data-mobile-nav>
        <summary class="icon-btn" aria-label="Open menu">{% render 'icon', name: 'menu' %}</summary>
        <div class="mobile-nav__panel">
          <div class="mobile-nav__head">
            <img src="{{ 'unify-organica-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="1355" height="400" class="brand-logo" style="max-width:130px">
            <button type="button" class="icon-btn" data-close-details aria-label="Close menu">{% render 'icon', name: 'close' %}</button>
          </div>
          <ul class="mobile-nav__list">
            {%- for link in section.settings.menu.links -%}
              {%- assign t = link.title | downcase -%}
              <li>
                {%- if link.links != blank -%}
                  <details>
                    <summary{% if t contains 'sale' %} class="is-sale"{% endif %}>{{ link.title }} {% render 'icon', name: 'plus' %}</summary>
                    <ul>
                      <li><a href="{{ link.url }}">All {{ link.title | downcase }}</a></li>
                      {%- for child in link.links -%}<li><a href="{{ child.url }}">{{ child.title }}</a></li>{%- endfor -%}
                    </ul>
                  </details>
                {%- else -%}
                  <a href="{{ link.url }}"{% if t contains 'sale' %} class="is-sale"{% endif %}>{{ link.title }}</a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
          {%- if shop.customer_accounts_enabled -%}
            <a class="btn btn--block" href="{{ routes.account_url }}">{% if customer %}My account{% else %}Sign in / Create account{% endif %}</a>
          {%- endif -%}
        </div>
      </details>
      <form action="{{ routes.search_url }}" method="get" role="search" class="pill-search">
        <input type="search" name="q" placeholder="Search" aria-label="Search">
        <input type="hidden" name="type" value="product">
        <button type="submit" aria-label="Search">{% render 'icon', name: 'search' %}</button>
      </form>
    </div>

    <a href="{{ routes.root_url }}" class="header__logo" aria-label="{{ shop.name }}">
      {%- assign logo_style = 'max-width:' | append: section.settings.logo_width | append: 'px' -%}
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 600 | image_tag: style: logo_style, class: 'brand-logo', alt: shop.name }}
      {%- else -%}
        <img src="{{ 'unify-organica-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="1355" height="400" class="brand-logo" style="{{ logo_style }}">
      {%- endif -%}
    </a>

    <div class="header__right">
      <a href="{{ routes.search_url }}" class="icon-btn show-mobile" aria-label="Search">{% render 'icon', name: 'search' %}</a>
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="icon-btn hide-mobile" aria-label="Account">{% render 'icon', name: 'account' %}</a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="cart-link" data-cart-open aria-label="Cart">
        {% render 'icon', name: 'bag' %}
        <span class="cart-link__label">Cart</span>
        <span class="cart-count" data-cart-count>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  <nav class="header__nav" aria-label="Main">
    <ul class="page-width">
      {%- for link in section.settings.menu.links -%}
        {%- assign t = link.title | downcase -%}
        <li class="{% if link.links != blank %}has-dropdown{% endif %}">
          <a href="{{ link.url }}" class="{% if t contains 'sale' %}is-sale{% endif %}" {% if link.active %}aria-current="page"{% endif %}>
            {{- link.title -}}
            {%- if link.links != blank %} <svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>{%- endif -%}
          </a>
          {%- if link.links != blank -%}
            <div class="dropdown">
              <ul>{%- for child in link.links -%}<li><a href="{{ child.url }}">{{ child.title }}</a></li>{%- endfor -%}</ul>
            </div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </nav>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo image", "info": "Leave empty to use the built-in Unify Organica logo." },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 80, "max": 320, "step": 10, "unit": "px", "default": 170 },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu", "info": "Menu items containing the word \"sale\" are shown in red." },
    { "type": "checkbox", "id": "sticky", "label": "Sticky header", "default": true }
  ]
}
{% endschema %}
