<section class="hero-banner" data-slider data-autoplay="{{ section.settings.autoplay_seconds }}" aria-roledescription="carousel">
  <div class="slider__track">
    {%- for block in section.blocks -%}
      {%- assign href = block.settings.link | default: routes.all_products_collection_url -%}
      <a href="{{ href }}" class="slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }} aria-label="{{ block.settings.alt | default: 'Shop now' | escape }}">
        {%- assign loading = 'lazy' -%}
        {%- if forloop.first -%}{%- assign loading = 'eager' -%}{%- endif -%}
        <picture>
          {%- if block.settings.image_mobile != blank -%}
            <source media="(max-width: 749px)" srcset="{{ block.settings.image_mobile | image_url: width: 1000 }}">
          {%- elsif block.settings.asset_mobile != blank -%}
            <source media="(max-width: 749px)" srcset="{{ block.settings.asset_mobile | asset_url }}">
          {%- endif -%}
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 1920, 2400', sizes: '100vw', loading: loading, class: 'slide__img', alt: block.settings.alt }}
          {%- else -%}
            <img src="{{ block.settings.asset | default: 'banner-hero.jpg' | asset_url }}" alt="{{ block.settings.alt | escape }}" width="2400" height="900" class="slide__img" loading="{{ loading }}">
          {%- endif -%}
        </picture>
      </a>
    {%- endfor -%}
  </div>
  {%- if section.blocks.size > 1 -%}
    <button type="button" class="slider__arrow slider__arrow--prev" data-slide-prev aria-label="Previous slide">{% render 'icon', name: 'arrow' %}</button>
    <button type="button" class="slider__arrow slider__arrow--next" data-slide-next aria-label="Next slide">{% render 'icon', name: 'arrow' %}</button>
    <div class="slider__dots">
      {%- for block in section.blocks -%}
        <button type="button" class="{% if forloop.first %}is-active{% endif %}" data-slide-to="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Banner slider",
  "settings": [
    { "type": "range", "id": "autoplay_seconds", "label": "Autoplay (seconds, 0 = off)", "min": 0, "max": 10, "step": 1, "default": 5 }
  ],
  "max_blocks": 6,
  "blocks": [
    { "type": "slide", "name": "Slide", "settings": [
      { "type": "image_picker", "id": "image", "label": "Banner image (desktop)", "info": "Recommended 2400 x 900." },
      { "type": "image_picker", "id": "image_mobile", "label": "Banner image (mobile)", "info": "Recommended 1000 x 1150." },
      { "type": "url", "id": "link", "label": "Link" },
      { "type": "text", "id": "alt", "label": "Image description (for accessibility)", "default": "Unify Organica products" },
      { "type": "text", "id": "asset", "label": "Built-in banner (desktop)", "default": "banner-hero.jpg", "info": "Used when no image is uploaded. Built-in: banner-hero.jpg, banner-body.jpg" },
      { "type": "text", "id": "asset_mobile", "label": "Built-in banner (mobile)", "default": "banner-hero-mobile.jpg", "info": "Built-in: banner-hero-mobile.jpg, banner-body-mobile.jpg" }
    ]}
  ],
  "presets": [{ "name": "Banner slider", "blocks": [{ "type": "slide" }] }]
}
{% endschema %}
