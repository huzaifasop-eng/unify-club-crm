<section class="slider" data-slider data-autoplay="{{ section.settings.autoplay_seconds }}" aria-roledescription="carousel">
  <div class="slider__track">
    {%- for block in section.blocks -%}
      <div class="slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }} aria-roledescription="slide" aria-label="{{ forloop.index }} of {{ forloop.length }}">
        {%- assign href = block.settings.link | default: routes.all_products_collection_url -%}
        {%- if block.settings.image != blank -%}
          <a href="{{ href }}" class="slide__img-link" aria-label="{{ block.settings.heading | default: 'Shop now' | escape }}">
            <picture>
              {%- if block.settings.image_mobile != blank -%}
                <source media="(max-width: 749px)" srcset="{{ block.settings.image_mobile | image_url: width: 900 }}">
              {%- endif -%}
              {{ block.settings.image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 1920, 2400', sizes: '100vw', loading: 'eager', class: 'slide__img', alt: block.settings.image.alt | default: block.settings.heading }}
            </picture>
          </a>
        {%- else -%}
          <div class="slide__art" style="--slide-bg: {{ block.settings.bg }}; --slide-ink: {{ block.settings.ink }};">
            <div class="page-width slide__grid">
              <div class="slide__packs">
                {% render 'bottle-art', type: block.settings.art_left, label: block.settings.art_left, class: 'slide__pack slide__pack--a' %}
                {% render 'bottle-art', type: block.settings.art_main, label: block.settings.art_main, class: 'slide__pack slide__pack--b' %}
                {% render 'bottle-art', type: block.settings.art_right, label: block.settings.art_right, class: 'slide__pack slide__pack--c' %}
              </div>
              <div class="slide__copy">
                {%- if block.settings.kicker != blank -%}<p class="slide__kicker">{{ block.settings.kicker }}</p>{%- endif -%}
                <h2 class="slide__title">{{ block.settings.heading }}</h2>
                {%- if block.settings.offer != blank -%}<p class="slide__offer"><small>{{ block.settings.offer_prefix }}</small>{{ block.settings.offer }}<small>{{ block.settings.offer_suffix }}</small></p>{%- endif -%}
                {%- if block.settings.button != blank -%}<a href="{{ href }}" class="btn">{{ block.settings.button }}</a>{%- endif -%}
              </div>
            </div>
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
  {%- if section.blocks.size > 1 -%}
    <button type="button" class="slider__arrow slider__arrow--prev" data-slide-prev aria-label="Previous slide">{% render 'icon', name: 'arrow' %}</button>
    <button type="button" class="slider__arrow slider__arrow--next" data-slide-next aria-label="Next slide">{% render 'icon', name: 'arrow' %}</button>
    <div class="slider__dots">
      {%- for block in section.blocks -%}
        <button type="button" class="{% if forloop.first %}is-active{% endif %}" data-slide-to="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Banner slider",
  "settings": [
    { "type": "range", "id": "autoplay_seconds", "label": "Autoplay (seconds, 0 = off)", "min": 0, "max": 10, "step": 1, "default": 5 }
  ],
  "max_blocks": 6,
  "blocks": [
    { "type": "slide", "name": "Slide", "settings": [
      { "type": "image_picker", "id": "image", "label": "Banner image (desktop)", "info": "Recommended 1920 x 730. When set, the image replaces the illustrated banner." },
      { "type": "image_picker", "id": "image_mobile", "label": "Banner image (mobile)", "info": "Recommended 800 x 1000." },
      { "type": "url", "id": "link", "label": "Link" },
      { "type": "header", "content": "Illustrated banner (no image)" },
      { "type": "text", "id": "kicker", "label": "Small text", "default": "Organic week" },
      { "type": "text", "id": "heading", "label": "Heading", "default": "The big organic sale" },
      { "type": "text", "id": "offer_prefix", "label": "Offer prefix", "default": "Up to" },
      { "type": "text", "id": "offer", "label": "Offer", "default": "30%" },
      { "type": "text", "id": "offer_suffix", "label": "Offer suffix", "default": "off" },
      { "type": "text", "id": "button", "label": "Button", "default": "Shop the sale" },
      { "type": "color", "id": "bg", "label": "Background", "default": "#eef3f1" },
      { "type": "color", "id": "ink", "label": "Offer colour", "default": "#e0453a" },
      { "type": "text", "id": "art_left", "label": "Left pack type", "default": "Shampoo" },
      { "type": "text", "id": "art_main", "label": "Centre pack type", "default": "Hair Oil" },
      { "type": "text", "id": "art_right", "label": "Right pack type", "default": "Hand & Feet Cream" }
    ]}
  ],
  "presets": [{ "name": "Banner slider", "blocks": [{ "type": "slide" }] }]
}
{% endschema %}
