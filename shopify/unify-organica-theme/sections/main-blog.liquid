<section class="collection-hero"><div class="page-width"><p class="eyebrow">The Journal</p><h1 class="h1">{{ blog.title }}</h1></div></section>
<section class="section section--tight">
  <div class="page-width">
    {%- paginate blog.articles by 9 -%}
      <div class="grid grid--articles">
        {%- for article in blog.articles -%}
          <article class="post">
            <a href="{{ article.url }}" class="post__media">
              {%- if article.image -%}{{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: article.title }}
              {%- else -%}<div class="post__art">{% render 'icon', name: 'leaf' %}</div>{%- endif -%}
            </a>
            <p class="small muted">{{ article.published_at | date: '%d %B %Y' }}</p>
            <h2 class="h4"><a href="{{ article.url }}">{{ article.title }}</a></h2>
            <p>{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
          </article>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<nav class="pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>
{% schema %}
{ "name": "Blog posts" }
{% endschema %}
