<section class="password">
  <div class="password__card">
    {%- assign logo_w = 260 -%}
    <img src="{{ 'unify-organica-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="1355" height="400" class="brand-logo"{% if logo_w %} style="max-width:{{ logo_w }}px"{% endif %}>
    <h1 class="h2">{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}<p class="lead">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="prelaunch">
      {%- if form.posted_successfully? -%}<p class="form-success">You're on the list. We'll email you at launch.</p>
      {%- else -%}
        <input type="email" name="contact[email]" placeholder="Email for launch access" required aria-label="Email">
        <button class="btn" type="submit">Notify me</button>
      {%- endif -%}
    {%- endform -%}
    <details class="password__login">
      <summary class="small">Store owner? Enter password</summary>
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}<p class="form-error">{{ form.errors | default_errors }}</p>{%- endif -%}
        <input type="password" name="password" placeholder="Password" aria-label="Password">
        <button class="btn btn--ghost" type="submit">Enter</button>
      {%- endform -%}
    </details>
  </div>
</section>
{% schema %}
{ "name": "Password page", "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Something pure is brewing" } ] }
{% endschema %}
