<section class="collection-hero"><div class="page-width"><h1 class="h1">{{ section.settings.heading }}</h1></div></section>
<section class="section section--tight">
  <div class="page-width cats">
    {%- for collection in collections -%}
      {%- unless collection.handle == 'frontpage' -%}
        <a href="{{ collection.url }}" class="cat" style="--cat-tone: {% cycle '#f1e1c6', '#dfe8d8', '#f3dcd2', '#dcebe6', '#f4ead8', '#d9e2d6' %}">
          <div class="cat__media">
            {%- if collection.image -%}{{ collection.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: collection.title }}
            {%- else -%}{% render 'bottle-art', type: collection.title, label: collection.title %}{%- endif -%}
          </div>
          <div class="cat__info"><h2 class="h4">{{ collection.title }}</h2><p>{{ collection.products_count }} products</p><span class="cat__go">{% render 'icon', name: 'arrow' %}</span></div>
        </a>
      {%- endunless -%}
    {%- endfor -%}
  </div>
</section>
{% schema %}
{ "name": "Collections list", "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Shop all rituals" } ] }
{% endschema %}
