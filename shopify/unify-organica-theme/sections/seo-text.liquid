<section class="section section--row">
  <div class="page-width seo">
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        <h2>{{ block.settings.heading }}</h2>
        <div class="rte">{{ block.settings.text }}</div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "SEO text",
  "max_blocks": 10,
  "blocks": [
    { "type": "text", "name": "Text block", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Natural hair care in Pakistan" },
      { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Write a short paragraph about this topic.</p>" }
    ]}
  ],
  "presets": [{ "name": "SEO text", "blocks": [{ "type": "text" }] }]
}
{% endschema %}
