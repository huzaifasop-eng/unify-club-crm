<section class="section">
  <div class="page-width">
    <h1 class="h1">Your bag</h1>
    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" class="cart">
        <div class="cart__lines">
          {%- for item in cart.items -%}
            <div class="line-item line-item--page">
              <a href="{{ item.url }}" class="line-item__media">
                {%- if item.image -%}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.title }}
                {%- else -%}{% render 'bottle-art', type: item.product.type, label: item.product.type %}{%- endif -%}
              </a>
              <div class="line-item__info">
                <a href="{{ item.url }}" class="line-item__title">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}<p class="muted small">{{ item.variant.title }}</p>{%- endunless -%}
                <p class="small">{{ item.final_price | money }}</p>
                <label class="visually-hidden" for="Qty-{{ forloop.index }}">Quantity</label>
                <input id="Qty-{{ forloop.index }}" class="qty-input" type="number" name="updates[]" value="{{ item.quantity }}" min="0">
                <a href="{{ item.url_to_remove }}" class="link-btn">Remove</a>
              </div>
              <div class="line-item__price"><strong>{{ item.final_line_price | money }}</strong></div>
            </div>
          {%- endfor -%}
        </div>
        <aside class="cart__summary">
          <h2 class="h4">Order summary</h2>
          <div class="drawer__total"><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></div>
          <p class="muted small">Taxes and shipping calculated at checkout.</p>
          <label for="CartNote" class="small">Gift note (optional)</label>
          <textarea id="CartNote" name="note" rows="3" placeholder="Write a little something…">{{ cart.note }}</textarea>
          <button type="submit" name="update" class="btn btn--ghost btn--block">Update bag</button>
          <button type="submit" name="checkout" class="btn btn--block">Checkout {% render 'icon', name: 'arrow' %}</button>
        </aside>
      </form>
    {%- else -%}
      <div class="empty">
        {% render 'bottle-art', type: 'Hair Oil', label: 'Empty for now' %}
        <p>Your bag is empty.</p>
        <a class="btn" href="{{ routes.all_products_collection_url }}">Start shopping</a>
      </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "Cart" }
{% endschema %}
