<section class="section" data-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=4">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="page-width">
      <div class="section-head"><div><p class="eyebrow">Complete the ritual</p><h2 class="h2">{{ section.settings.heading }}</h2></div></div>
      <div class="grid grid--products">
        {%- for product in recommendations.products -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Product recommendations",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pairs beautifully with" }
  ]
}
{% endschema %}
