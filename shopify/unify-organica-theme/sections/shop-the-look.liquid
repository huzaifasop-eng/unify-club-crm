<section class="section section--row">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}<div class="row-head"><h2>{{ section.settings.heading }}</h2></div>{%- endif -%}
    <div class="looks" data-carousel>
      <div class="looks__track" data-carousel-track>
        {%- for block in section.blocks -%}
          {%- assign p = block.settings.product -%}
          {%- assign h = block.settings.sample -%}
          {%- liquid
            assign url = routes.all_products_collection_url
            assign name = block.settings.sample_title
            assign price = block.settings.sample_price | times: 100
            assign thumb = 'product-' | append: h | append: '.jpg' | asset_url
            if p != blank
              assign url = p.url
              assign name = p.title
              assign price = p.price
              if p.featured_media
                assign thumb = p.featured_media | image_url: width: 120
              endif
            endif
          -%}
          <a href="{{ url }}" class="look" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 500, 700', sizes: '(min-width: 990px) 24vw, 70vw', alt: name }}
            {%- else -%}
              <img src="{{ 'look-' | append: h | append: '.jpg' | asset_url }}" alt="{{ name | escape }}" width="683" height="1024" loading="lazy">
            {%- endif -%}
            <span class="look__chip">
              <img src="{{ thumb }}" alt="" width="44" height="44" loading="lazy">
              <span><strong>{{ name }}</strong><small>{{ price | money }}</small></span>
            </span>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop the look",
  "settings": [ { "type": "text", "id": "heading", "label": "Heading" } ],
  "max_blocks": 8,
  "blocks": [
    { "type": "look", "name": "Look", "settings": [
      { "type": "image_picker", "id": "image", "label": "Lifestyle image", "info": "Portrait 2:3 recommended." },
      { "type": "product", "id": "product", "label": "Product" },
      { "type": "select", "id": "sample", "label": "Built-in image & sample product", "default": "hair-oil", "options": [
        { "value": "hair-oil", "label": "Hair Oil" }, { "value": "hair-shampoo", "label": "Hair Shampoo" }, { "value": "joints-oil", "label": "Joints Oil" },
        { "value": "body-wash", "label": "Body Wash" }, { "value": "hand-wash", "label": "Hand Wash" }
      ]},
      { "type": "text", "id": "sample_title", "label": "Sample name (before a product is chosen)", "default": "Hair Oil" },
      { "type": "number", "id": "sample_price", "label": "Sample price", "default": 1200 }
    ]}
  ],
  "presets": [{ "name": "Shop the look", "blocks": [{ "type": "look" }, { "type": "look" }] }]
}
{% endschema %}
