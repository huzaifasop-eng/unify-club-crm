<section class="section section--compact">
  <div class="page-width">
    {%- if section.settings.tagline != blank -%}<p class="tagline">{{ section.settings.tagline }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="section-title section-title--plain">{{ section.settings.heading }}</h2>{%- endif -%}
    <ul class="cat-buttons">
      {%- for block in section.blocks -%}
        {%- assign url = block.settings.link | default: routes.all_products_collection_url -%}
        <li {{ block.shopify_attributes }}><a href="{{ url }}" class="cat-button">{{ block.settings.label }}</a></li>
      {%- endfor -%}
    </ul>
    {%- if section.settings.banner != blank -%}
      <a href="{{ section.settings.banner_link | default: routes.all_products_collection_url }}" class="cat-banner">
        {{ section.settings.banner | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '750, 1100, 1500, 2000', sizes: '(min-width: 1320px) 1240px, 100vw', alt: section.settings.heading }}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Category buttons",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline above", "default": "Pure botanicals. Honest formulas. Visible results." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "image_picker", "id": "banner", "label": "Banner image below (optional)" },
    { "type": "url", "id": "banner_link", "label": "Banner link" }
  ],
  "max_blocks": 12,
  "blocks": [
    { "type": "button", "name": "Button", "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Hair oils" },
      { "type": "url", "id": "link", "label": "Link" }
    ]}
  ],
  "presets": [{ "name": "Category buttons", "blocks": [
    { "type": "button", "settings": { "label": "Hair oils" } },
    { "type": "button", "settings": { "label": "Shampoos" } },
    { "type": "button", "settings": { "label": "Body wash" } },
    { "type": "button", "settings": { "label": "Hand wash" } }
  ]}]
}
{% endschema %}
