<section class="section">
  <div class="page-width">
    <div class="newsletter reveal">
      <div class="newsletter__art" aria-hidden="true">{% render 'icon', name: 'leaf' %}{% render 'icon', name: 'leaf' %}</div>
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="h2">{{ section.settings.heading }}</h2>
      <div class="rte">{{ section.settings.text }}</div>
      {%- form 'customer', class: 'newsletter__form', id: 'newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="form-success">{% render 'icon', name: 'sparkle' %} Welcome to the circle — check your inbox for your code.</p>
        {%- else -%}
          <label for="NewsletterEmail" class="visually-hidden">Email</label>
          <input id="NewsletterEmail" type="email" name="contact[email]" placeholder="you@example.com" autocomplete="email" required>
          <button type="submit" class="btn">Subscribe</button>
          {%- if form.errors -%}<p class="form-error">{{ form.errors | default_errors }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Join the Organica circle" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "10% off your first ritual" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Hair-care tips, early access to new batches and members-only offers. No spam, ever.</p>" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
