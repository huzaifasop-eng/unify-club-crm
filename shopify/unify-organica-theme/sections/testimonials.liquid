<section class="section section--compact">
  <div class="page-width">
    <h2 class="section-title section-title--plain">{{ section.settings.heading }}</h2>
    <div class="carousel carousel--reviews" data-carousel>
      <button type="button" class="carousel__btn carousel__btn--prev" data-carousel-prev aria-label="Previous">{% render 'icon', name: 'arrow' %}</button>
      <div class="carousel__track" data-carousel-track>
        {%- for block in section.blocks -%}
          <figure class="review carousel__item" {{ block.shopify_attributes }}>
            <div class="review__media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', alt: block.settings.product }}
              {%- else -%}
                {% render 'bottle-art', type: block.settings.product, label: block.settings.product %}
              {%- endif -%}
            </div>
            <div class="review__body">
              <div class="review__meta">
                <span class="stars" aria-label="{{ block.settings.rating }} out of 5">{%- for i in (1..block.settings.rating) -%}{% render 'icon', name: 'star' %}{%- endfor -%}</span>
                <span class="small muted">{{ block.settings.date }}</span>
              </div>
              <p class="review__product">{{ block.settings.product }}</p>
              <blockquote>{{ block.settings.quote }}</blockquote>
              <figcaption>{{ block.settings.author }}{% if block.settings.verified %} <span class="verified">Verified buyer</span>{% endif %}</figcaption>
            </div>
          </figure>
        {%- endfor -%}
      </div>
      <button type="button" class="carousel__btn carousel__btn--next" data-carousel-next aria-label="Next">{% render 'icon', name: 'arrow' %}</button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Customer reviews" }
  ],
  "max_blocks": 12,
  "blocks": [
    { "type": "review", "name": "Review", "settings": [
      { "type": "image_picker", "id": "image", "label": "Customer photo" },
      { "type": "text", "id": "product", "label": "Product", "default": "Hair Oil" },
      { "type": "textarea", "id": "quote", "label": "Review", "default": "Replace with a real customer review." },
      { "type": "text", "id": "author", "label": "Name", "default": "Customer" },
      { "type": "text", "id": "date", "label": "Date text", "default": "2 weeks ago" },
      { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
      { "type": "checkbox", "id": "verified", "label": "Verified buyer", "default": true }
    ]}
  ],
  "presets": [{ "name": "Customer reviews", "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }] }]
}
{% endschema %}
