<section class="collection-hero">
  <div class="page-width">
    <h1 class="h1">Search</h1>
    <form action="{{ routes.search_url }}" method="get" class="search-page__form" role="search">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search for rosemary, shea, shampoo…" aria-label="Search">
      <input type="hidden" name="type" value="product">
      <button class="btn" type="submit">Search</button>
    </form>
  </div>
</section>
<section class="section section--tight">
  <div class="page-width">
    {%- if search.performed -%}
      {%- paginate search.results by 16 -%}
        <p class="muted small">{{ search.results_count }} results for “{{ search.terms | escape }}”</p>
        {%- if search.results_count > 0 -%}
          <div class="grid grid--products">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {% render 'product-card', product: item %}
              {%- else -%}
                <a href="{{ item.url }}" class="card card--text"><p class="card__type">{{ item.object_type }}</p><h3 class="card__title">{{ item.title }}</h3></a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- if paginate.pages > 1 -%}<nav class="pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "Search results" }
{% endschema %}
