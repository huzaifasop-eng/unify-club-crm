<section class="section">
  <div class="page-width split{% if section.settings.reverse %} split--reverse{% endif %}">
    <div class="split__media reveal" style="--split-bg: {{ section.settings.bg }}">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500, 800, 1200', sizes: '(min-width: 990px) 50vw, 100vw', alt: section.settings.heading }}
      {%- else -%}
        <div class="split__art">
          {% render 'bottle-art', type: 'Gift Set', label: 'Ritual Box' %}
          {% render 'bottle-art', type: 'Hair Oil', label: 'Argan Serum', class: 'split__art-sm' %}
        </div>
      {%- endif -%}
    </div>
    <div class="split__copy reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
      <div class="rte">{{ section.settings.text }}</div>
      {%- if section.settings.button_label != blank -%}<a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn">{{ section.settings.button_label }} {% render 'icon', name: 'arrow' %}</a>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "color", "id": "bg", "label": "Panel colour (when no image)", "default": "#e6dcc8" },
    { "type": "checkbox", "id": "reverse", "label": "Image on right", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Gifting, made thoughtful" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build a ritual box — save 15%" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Pick any three products and we'll pack them in our seed-paper gift box with a handwritten note. Perfect for Eid, weddings and birthdays.</p>" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Shop gift sets" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
