{%- if section.blocks.size > 0 -%}
<div class="announce" data-announce {{ section.shopify_attributes }}>
  <div class="page-width announce__inner">
    {%- for block in section.blocks -%}
      <p class="announce__item{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>{%- else -%}{{ block.settings.text }}{%- endif -%}
      </p>
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 6,
  "blocks": [
    { "type": "message", "name": "Message", "settings": [
      { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on all orders above Rs 3,000" },
      { "type": "url", "id": "link", "label": "Link" }
    ]}
  ],
  "default": {
    "blocks": [
      { "type": "message", "settings": { "text": "Free shipping on all orders above Rs 3,000" } },
      { "type": "message", "settings": { "text": "Cash on delivery available nationwide" } }
    ]
  }
}
{% endschema %}
