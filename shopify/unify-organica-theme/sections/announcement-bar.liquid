{%- if section.blocks.size > 0 -%}
<div class="announce" {{ section.shopify_attributes }}>
  <div class="announce__track">
    {%- for i in (1..2) -%}
      <div class="announce__group" {% if i == 2 %}aria-hidden="true"{% endif %}>
        {%- for block in section.blocks -%}
          <span class="announce__item" {{ block.shopify_attributes }}>
            {% render 'icon', name: 'leaf' %}
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>{%- else -%}{{ block.settings.text }}{%- endif -%}
          </span>
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announce",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on orders over 3,000" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "message", "settings": { "text": "Free shipping on orders over 3,000" } },
      { "type": "message", "settings": { "text": "100% certified organic ingredients" } },
      { "type": "message", "settings": { "text": "Cruelty-free · Paraben-free · Sulphate-free" } },
      { "type": "message", "settings": { "text": "Cash on delivery available" } }
    ]
  }
}
{% endschema %}
