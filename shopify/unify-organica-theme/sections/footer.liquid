<footer class="footer">
  <div class="page-width footer__grid">
    <div class="footer__brand">
      <a href="{{ routes.root_url }}" class="footer__logo">{%- assign logo_w = 190 -%}<img src="{{ 'unify-organica-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="1355" height="400" class="brand-logo"{% if logo_w %} style="max-width:{{ logo_w }}px"{% endif %}></a>
      <p>{{ section.settings.blurb }}</p>
      <ul class="social">
        {%- if settings.social_facebook != blank -%}<li><a href="{{ settings.social_facebook }}" aria-label="Facebook">{% render 'icon', name: 'facebook' %}</a></li>{%- endif -%}
        {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram }}" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a></li>{%- endif -%}
        {%- if settings.social_tiktok != blank -%}<li><a href="{{ settings.social_tiktok }}" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a></li>{%- endif -%}
        {%- if settings.social_youtube != blank -%}<li><a href="{{ settings.social_youtube }}" aria-label="YouTube">{% render 'icon', name: 'youtube' %}</a></li>{%- endif -%}
      </ul>
    </div>
    {%- for block in section.blocks -%}
      <div class="footer__col" {{ block.shopify_attributes }}>
        <h3 class="footer__title">{{ block.settings.title }}</h3>
        {%- case block.type -%}
          {%- when 'menu' -%}
            <ul>{%- for link in block.settings.menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}</ul>
          {%- when 'newsletter' -%}
            <p>{{ block.settings.text }}</p>
            {%- form 'customer', class: 'footer__form', id: 'footer-newsletter' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              {%- if form.posted_successfully? -%}
                <p class="form-success">Thanks for subscribing!</p>
              {%- else -%}
                <input type="email" name="contact[email]" placeholder="Your email" aria-label="Email" autocomplete="email" required>
                <button type="submit" class="btn">Subscribe</button>
              {%- endif -%}
            {%- endform -%}
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>
  <div class="footer__bottom">
    <div class="page-width footer__bottom-inner">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}. All rights reserved.</p>
      {%- if section.settings.show_payment -%}
        <ul class="payments" aria-label="Payment methods">
          {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'icon--payment' }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "textarea", "id": "blurb", "label": "Brand text", "default": "Organic hair and body care, made in small batches from plant oils, herbs and butters." },
    { "type": "checkbox", "id": "show_payment", "label": "Show payment icons", "default": true }
  ],
  "max_blocks": 4,
  "blocks": [
    { "type": "menu", "name": "Menu", "settings": [
      { "type": "text", "id": "title", "label": "Heading", "default": "About us" },
      { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
    ]},
    { "type": "newsletter", "name": "Newsletter", "limit": 1, "settings": [
      { "type": "text", "id": "title", "label": "Heading", "default": "Newsletter" },
      { "type": "text", "id": "text", "label": "Text", "default": "Be first to know about new launches and sales." }
    ]}
  ],
  "default": {
    "blocks": [
      { "type": "menu", "settings": { "title": "About us", "menu": "footer" } },
      { "type": "menu", "settings": { "title": "Quick links", "menu": "main-menu" } },
      { "type": "newsletter", "settings": {} }
    ]
  }
}
{% endschema %}
