<section class="section">
  <div class="page-width">
    <div class="section-head section-head--center reveal">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h2">{{ section.settings.heading }}</h2>
      </div>
    </div>
    <ol class="steps">
      {%- for block in section.blocks -%}
        <li class="step reveal" style="--d: {{ forloop.index0 | times: 80 }}ms" {{ block.shopify_attributes }}>
          <span class="step__num">{{ forloop.index | prepend: '0' }}</span>
          <span class="step__icon">{% render 'icon', name: block.settings.icon %}</span>
          <h3 class="h4">{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Ritual steps",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "From farm to shelf" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How every bottle is made" }
  ],
  "max_blocks": 4,
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Sourced" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Herbs and seeds from certified organic growers." },
      { "type": "select", "id": "icon", "label": "Icon", "default": "leaf", "options": [
        { "value": "leaf", "label": "Leaf" }, { "value": "drop", "label": "Drop" }, { "value": "hand", "label": "Hand" },
        { "value": "shield", "label": "Shield" }, { "value": "sparkle", "label": "Sparkle" }, { "value": "truck", "label": "Truck" }
      ]}
    ]}
  ],
  "presets": [{
    "name": "Ritual steps",
    "blocks": [
      { "type": "step", "settings": { "title": "Sourced honestly", "text": "Herbs, seeds and butters from certified organic farms we know by name.", "icon": "leaf" } },
      { "type": "step", "settings": { "title": "Cold-pressed", "text": "Oils pressed without heat so the vitamins and fatty acids stay intact.", "icon": "drop" } },
      { "type": "step", "settings": { "title": "Hand-poured", "text": "Small batches, poured and labelled by hand, dated for freshness.", "icon": "hand" } },
      { "type": "step", "settings": { "title": "Tested on people", "text": "Dermatologically tested on volunteers — never on animals.", "icon": "shield" } }
    ]
  }]
}
{% endschema %}
