<section class="claims" {{ section.shopify_attributes }}>
  <div class="claims__track">
    {%- for i in (1..2) -%}
      <ul class="claims__group" {% if i == 2 %}aria-hidden="true"{% endif %}>
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            {%- if block.settings.detail != blank and i == 1 -%}
              <button type="button" popovertarget="claim-{{ section.id }}-{{ forloop.index }}">{{ block.settings.text }}</button>
            {%- else -%}
              <span>{{ block.settings.text }}</span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endfor -%}
  </div>
  {%- for block in section.blocks -%}
    {%- if block.settings.detail != blank -%}
      <div class="claim-pop" popover id="claim-{{ section.id }}-{{ forloop.index }}">
        <span class="claim-pop__icon">{% render 'icon', name: block.settings.icon %}</span>
        <h3 class="h4">{{ block.settings.text }}</h3>
        <p>{{ block.settings.detail }}</p>
        <button type="button" class="btn btn--outline" popovertarget="claim-{{ section.id }}-{{ forloop.index }}" popovertargetaction="hide">Close</button>
      </div>
    {%- endif -%}
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Claims strip",
  "blocks": [
    { "type": "item", "name": "Claim", "settings": [
      { "type": "text", "id": "text", "label": "Text", "default": "Organic" },
      { "type": "textarea", "id": "detail", "label": "Pop-up explanation", "info": "Optional. Shown when the claim is clicked." },
      { "type": "select", "id": "icon", "label": "Pop-up icon", "default": "leaf", "options": [
        { "value": "leaf", "label": "Leaf" }, { "value": "drop", "label": "Drop" }, { "value": "rabbit", "label": "Cruelty-free" },
        { "value": "shield", "label": "Shield" }, { "value": "hand", "label": "Handmade" }, { "value": "recycle", "label": "Recycle" },
        { "value": "truck", "label": "Delivery" }, { "value": "sparkle", "label": "Sparkle" }
      ]}
    ]}
  ],
  "presets": [{ "name": "Claims strip", "blocks": [
    { "type": "item", "settings": { "text": "Organic", "icon": "leaf" } },
    { "type": "item", "settings": { "text": "Cruelty free", "icon": "rabbit" } },
    { "type": "item", "settings": { "text": "Paraben free", "icon": "shield" } }
  ]}]
}
{% endschema %}
