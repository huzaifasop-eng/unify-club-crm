<section class="hero" style="--hero-bg: {{ section.settings.bg }};">
  <div class="hero__blob hero__blob--a" aria-hidden="true"></div>
  <div class="hero__blob hero__blob--b" aria-hidden="true"></div>
  <div class="page-width hero__grid">
    <div class="hero__copy reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{% render 'icon', name: 'leaf' %} {{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="hero__title">{{ section.settings.heading }}</h1>
      <div class="hero__text rte">{{ section.settings.text }}</div>
      <div class="hero__ctas">
        {%- if section.settings.button_label != blank -%}<a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn">{{ section.settings.button_label }} {% render 'icon', name: 'arrow' %}</a>{%- endif -%}
        {%- if section.settings.button2_label != blank -%}<a href="{{ section.settings.button2_link | default: routes.all_products_collection_url }}" class="btn btn--ghost">{{ section.settings.button2_label }}</a>{%- endif -%}
      </div>
      <ul class="hero__proof">
        <li><strong>{{ section.settings.stat1_value }}</strong><span>{{ section.settings.stat1_label }}</span></li>
        <li><strong>{{ section.settings.stat2_value }}</strong><span>{{ section.settings.stat2_label }}</span></li>
        <li><strong>{{ section.settings.stat3_value }}</strong><span>{{ section.settings.stat3_label }}</span></li>
      </ul>
    </div>
    <div class="hero__visual reveal">
      {%- if section.settings.image != blank -%}
        <div class="hero__photo">
          {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1400', sizes: '(min-width: 990px) 50vw, 100vw', alt: section.settings.image.alt | default: section.settings.heading }}
        </div>
      {%- else -%}
        <div class="hero__stage">
          <div class="hero__sun"></div>
          <div class="hero__bottle hero__bottle--1">{% render 'bottle-art', type: 'Body Wash', label: 'Body Wash' %}</div>
          <div class="hero__bottle hero__bottle--2">{% render 'bottle-art', type: 'Hair Oil', label: 'Rosemary Oil' %}</div>
          <div class="hero__bottle hero__bottle--3">{% render 'bottle-art', type: 'Hand & Feet Cream', label: 'Shea Cream' %}</div>
          <span class="hero__leaf hero__leaf--1">{% render 'icon', name: 'leaf' %}</span>
          <span class="hero__leaf hero__leaf--2">{% render 'icon', name: 'leaf' %}</span>
          <span class="hero__leaf hero__leaf--3">{% render 'icon', name: 'leaf' %}</span>
        </div>
      {%- endif -%}
      <div class="hero__seal" aria-hidden="true">
        <svg viewBox="0 0 120 120"><defs><path id="seal-circle" d="M60 60 m-44 0 a44 44 0 1 1 88 0 a44 44 0 1 1 -88 0"/></defs><text font-size="10.5"><textPath href="#seal-circle" textLength="272" lengthAdjust="spacing">{{ section.settings.seal_text | upcase }}</textPath></text></svg>
        <span>{% render 'icon', name: 'leaf' %}</span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Certified organic · Small batch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Rooted in nature. Made for your rituals." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Cold-pressed hair oils, gentle shampoos and nourishing body care — crafted from botanicals, never from shortcuts.</p>" },
    { "type": "text", "id": "button_label", "label": "Primary button", "default": "Shop the collection" },
    { "type": "url", "id": "button_link", "label": "Primary link" },
    { "type": "text", "id": "button2_label", "label": "Secondary button", "default": "Find your hair ritual" },
    { "type": "url", "id": "button2_link", "label": "Secondary link" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Optional. Without an image, an illustrated product composition is shown." },
    { "type": "color", "id": "bg", "label": "Background", "default": "#efe7d8" },
    { "type": "text", "id": "seal_text", "label": "Rotating seal text", "default": "100% organic · hand poured · " },
    { "type": "header", "content": "Proof points" },
    { "type": "text", "id": "stat1_value", "label": "Stat 1 value", "default": "0%" },
    { "type": "text", "id": "stat1_label", "label": "Stat 1 label", "default": "Parabens & sulphates" },
    { "type": "text", "id": "stat2_value", "label": "Stat 2 value", "default": "20+" },
    { "type": "text", "id": "stat2_label", "label": "Stat 2 label", "default": "Botanical actives" },
    { "type": "text", "id": "stat3_value", "label": "Stat 3 value", "default": "4.9★" },
    { "type": "text", "id": "stat3_label", "label": "Stat 3 label", "default": "Customer rating" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
