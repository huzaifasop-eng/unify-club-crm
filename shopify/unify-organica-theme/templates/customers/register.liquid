<section class="section"><div class="page-width auth">
  <h1 class="h2 center">Join Unify Organica</h1>
  {%- form 'create_customer', class: 'contact-form' -%}
    {%- if form.errors -%}<p class="form-error">{{ form.errors | default_errors }}</p>{%- endif -%}
    <div class="field-row">
      <label>First name<input type="text" name="customer[first_name]" autocomplete="given-name"></label>
      <label>Last name<input type="text" name="customer[last_name]" autocomplete="family-name"></label>
    </div>
    <label>Email<input type="email" name="customer[email]" autocomplete="email" required></label>
    <label>Password<input type="password" name="customer[password]" autocomplete="new-password" required></label>
    <button type="submit" class="btn btn--block">Create account</button>
  {%- endform -%}
</div></section>
