# Database
DATABASE_URL="postgresql://unify:unify_password@localhost:5432/unify_club_crm?schema=public"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# App
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# Notifications (provider-agnostic; mock/console implementations used when not configured)
NOTIFICATION_EMAIL_PROVIDER=console   # console | smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Unify Club <no-reply@unifyclub.org>"

NOTIFICATION_WHATSAPP_PROVIDER=console # console | whatsapp_cloud_api
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

NOTIFICATION_PUSH_PROVIDER=console      # console | firebase
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Storage (provider-agnostic; mock/console implementation used when not configured)
STORAGE_PROVIDER=local   # local | s3 | cloudinary
STORAGE_LOCAL_DIR=./uploads
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
