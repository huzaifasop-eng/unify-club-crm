// ============================================================================
// UNIFY CLUB ERP & CRM — Prisma Schema
// Covers all 24 modules. High-priority modules have rich models; placeholder
// modules have minimal models sufficient for a stub controller + nav page.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum LeadStage {
  NEW_LEAD
  CONTACTED
  INTERESTED
  FOLLOW_UP
  TRIAL_BOOKED
  TRIAL_COMPLETED
  ADMISSION_PENDING
  ENROLLED
  LOST
  DUPLICATE
  JUNK
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LeadSource {
  WEBSITE
  REFERRAL
  WALK_IN
  SOCIAL_MEDIA
  PHONE_INQUIRY
  EVENT
  CAMPAIGN
  OTHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AdmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  ENROLLED
  WITHDRAWN
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  CHEQUE
  ONLINE
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  EXCUSED
  HOLIDAY
}

enum AttendeeType {
  CHILD
  STAFF
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
  RESIGNED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  CASUAL
  SICK
  ANNUAL
  UNPAID
  MATERNITY
  PATERNITY
  OTHER
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  READ
}

enum CallDirection {
  INBOUND
  OUTBOUND
  MISSED
}

enum CallOutcome {
  CONNECTED
  NO_ANSWER
  VOICEMAIL
  WRONG_NUMBER
  CALLBACK_REQUESTED
  CONVERTED
  NOT_INTERESTED
}

enum TrialStatus {
  SCHEDULED
  COMPLETED
  NO_SHOW
  CANCELLED
  RESCHEDULED
}

enum EventStatus {
  PLANNED
  ONGOING
  COMPLETED
  CANCELLED
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum InventoryTxnType {
  IN
  OUT
  ADJUSTMENT
}

// ============================================================================
// CORE: BRANCH, RBAC, USER
// ============================================================================

model Branch {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  address   String?
  city      String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          UserBranch[]
  leads          Lead[]
  children       Child[]
  admissions     Admission[]
  staff          Staff[]
  invoices       Invoice[]
  attendances    Attendance[]
  feeStructures  FeeStructure[]
  calls          Call[]
  trials         Trial[]
  events         Event[]
  expenses       Expense[]
  ledgerEntries  LedgerEntry[]
  inventoryItems InventoryItem[]
  documents      Document[]
  campaigns      Campaign[]
  notifications  Notification[]

  @@map("branches")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id        String   @id @default(uuid())
  resource  String // e.g. "leads", "fees", "children"
  action    String // e.g. "create", "read", "update", "delete", "manage"
  createdAt DateTime @default(now())

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String
  firstName         String
  lastName          String
  phone             String?
  avatarUrl         String?
  isActive          Boolean   @default(true)
  lastLoginAt       DateTime?
  refreshTokenHash  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  roles          UserRole[]
  branches       UserBranch[]
  assignedLeads  Lead[]            @relation("AssignedLeads")
  createdLeads   Lead[]            @relation("CreatedLeads")
  staffProfile   Staff?
  parentProfile  ParentProfile?
  leadActivities LeadActivity[]
  calls          Call[]            @relation("CallHandler")
  payments       Payment[]         @relation("RecordedBy")
  notifications  Notification[]    @relation("NotificationRecipient")

  @@map("users")
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model UserBranch {
  userId   String
  branchId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@map("user_branches")
}

// ============================================================================
// LEAD CRM
// ============================================================================

model Lead {
  id              String       @id @default(uuid())
  branchId        String
  branch          Branch       @relation(fields: [branchId], references: [id])

  parentName      String
  parentPhone     String
  parentEmail     String?
  parentAddress   String?

  childName       String
  childDob        DateTime?
  childGender     Gender?
  diagnosis       String?
  diagnosisNotes  String?

  source          LeadSource   @default(OTHER)
  stage           LeadStage    @default(NEW_LEAD)
  priority        LeadPriority @default(MEDIUM)

  assignedToId    String?
  assignedTo      User?        @relation("AssignedLeads", fields: [assignedToId], references: [id])
  createdById     String?
  createdBy       User?        @relation("CreatedLeads", fields: [createdById], references: [id])

  followUpDate    DateTime?
  notes           String?
  lostReason      String?
  isDuplicate     Boolean      @default(false)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  activities LeadActivity[]
  calls      Call[]
  trials     Trial[]
  admission  Admission?

  @@index([branchId])
  @@index([stage])
  @@index([assignedToId])
  @@map("leads")
}

model LeadActivity {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  type      String // e.g. "stage_change", "note", "call_logged"
  fromStage LeadStage?
  toStage   LeadStage?
  note      String?
  createdAt DateTime @default(now())

  @@index([leadId])
  @@map("lead_activities")
}

// ============================================================================
// ADMISSIONS
// ============================================================================

model Admission {
  id                 String          @id @default(uuid())
  admissionNumber    String          @unique
  branchId           String
  branch             Branch          @relation(fields: [branchId], references: [id])
  leadId             String?         @unique
  lead               Lead?           @relation(fields: [leadId], references: [id])

  childId            String?         @unique
  child              Child?          @relation(fields: [childId], references: [id])

  // Child snapshot at time of admission
  childName          String
  childDob           DateTime
  childGender        Gender

  guardianName       String
  guardianRelation    String?
  guardianPhone       String
  guardianEmail       String?
  guardianCnic        String?

  emergencyContactName  String?
  emergencyContactPhone String?
  emergencyRelation     String?

  medicalHistory     String?
  diagnosis          String?
  allergies           String?
  medications         String?

  status             AdmissionStatus @default(DRAFT)
  submittedAt        DateTime?
  approvedAt         DateTime?
  rejectedReason      String?

  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  documents Document[]

  @@index([branchId])
  @@index([status])
  @@map("admissions")
}

// ============================================================================
// CHILD PROFILE
// ============================================================================

model Child {
  id              String    @id @default(uuid())
  branchId        String
  branch          Branch    @relation(fields: [branchId], references: [id])

  firstName       String
  lastName        String
  dob             DateTime
  gender          Gender

  diagnosis       String?
  diagnosisDate   DateTime?
  strengths       String?
  goals           String?
  medicalConditions String?
  allergies       String?
  medications     String?

  guardianName    String
  guardianPhone   String
  guardianEmail   String?
  guardianAddress String?

  photoUrl        String?
  isActive        Boolean   @default(true)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  admission        Admission?
  progressNotes    ProgressNote[]
  attendances      Attendance[]
  invoices         Invoice[]
  parentLinks      ParentChild[]
  documents        Document[]

  @@index([branchId])
  @@map("children")
}

model ProgressNote {
  id        String   @id @default(uuid())
  childId   String
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  authorId  String?
  note      String
  category  String? // therapy, sports, academic, behavioral
  createdAt DateTime @default(now())

  @@index([childId])
  @@map("progress_notes")
}

// ============================================================================
// PARENT PORTAL (placeholder-level, linked for future expansion)
// ============================================================================

model ParentProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String?
  createdAt DateTime @default(now())

  children ParentChild[]

  @@map("parent_profiles")
}

model ParentChild {
  parentProfileId String
  childId         String
  parentProfile   ParentProfile @relation(fields: [parentProfileId], references: [id], onDelete: Cascade)
  child           Child         @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@id([parentProfileId, childId])
  @@map("parent_children")
}

// ============================================================================
// FEES MANAGEMENT
// ============================================================================

model FeeStructure {
  id          String   @id @default(uuid())
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  name        String
  description String?
  amount      Decimal  @db.Decimal(12, 2)
  frequency   String // monthly, quarterly, annual, one-time
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoiceItems InvoiceItem[]

  @@index([branchId])
  @@map("fee_structures")
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  branchId      String
  branch        Branch        @relation(fields: [branchId], references: [id])
  childId       String
  child         Child         @relation(fields: [childId], references: [id])

  issueDate     DateTime      @default(now())
  dueDate       DateTime
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(12, 2)
  status        InvoiceStatus @default(ISSUED)
  notes         String?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items    InvoiceItem[]
  payments Payment[]

  @@index([branchId])
  @@index([childId])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id             String        @id @default(uuid())
  invoiceId      String
  invoice        Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeStructureId String?
  feeStructure   FeeStructure? @relation(fields: [feeStructureId], references: [id])
  description    String
  amount         Decimal       @db.Decimal(12, 2)

  @@map("invoice_items")
}

model Payment {
  id            String        @id @default(uuid())
  invoiceId     String
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod @default(CASH)
  reference     String?
  paidAt        DateTime      @default(now())
  recordedById  String?
  recordedBy    User?         @relation("RecordedBy", fields: [recordedById], references: [id])
  notes         String?
  createdAt     DateTime      @default(now())

  @@index([invoiceId])
  @@map("payments")
}

// ============================================================================
// ATTENDANCE
// ============================================================================

model Attendance {
  id           String           @id @default(uuid())
  branchId     String
  branch       Branch           @relation(fields: [branchId], references: [id])
  attendeeType AttendeeType
  childId      String?
  child        Child?           @relation(fields: [childId], references: [id])
  staffId      String?
  staff        Staff?           @relation(fields: [staffId], references: [id])
  date         DateTime
  status       AttendanceStatus @default(PRESENT)
  checkInTime  DateTime?
  checkOutTime DateTime?
  notes        String?
  markedById   String?
  createdAt    DateTime         @default(now())

  @@index([branchId, date])
  @@index([childId])
  @@index([staffId])
  @@map("attendances")
}

// ============================================================================
// HR BASICS
// ============================================================================

model Staff {
  id               String           @id @default(uuid())
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId         String
  branch           Branch           @relation(fields: [branchId], references: [id])
  employeeCode     String           @unique
  designation      String?
  department       String?
  joinDate         DateTime?
  status           EmploymentStatus @default(ACTIVE)
  salary           Decimal?         @db.Decimal(12, 2)
  cnic             String?
  address          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leaveRequests LeaveRequest[]
  attendances   Attendance[]
  payrollRuns   PayrollEntry[]

  @@index([branchId])
  @@map("staff")
}

model LeaveRequest {
  id        String      @id @default(uuid())
  staffId   String
  staff     Staff       @relation(fields: [staffId], references: [id], onDelete: Cascade)
  type      LeaveType   @default(CASUAL)
  startDate DateTime
  endDate   DateTime
  reason    String?
  status    LeaveStatus @default(PENDING)
  approvedById String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([staffId])
  @@map("leave_requests")
}

// ============================================================================
// PLACEHOLDER MODULES (schema-only / minimal)
// ============================================================================

// --- Call Management ---
model Call {
  id          String        @id @default(uuid())
  branchId    String
  branch      Branch        @relation(fields: [branchId], references: [id])
  leadId      String?
  lead        Lead?         @relation(fields: [leadId], references: [id])
  handledById String?
  handledBy   User?         @relation("CallHandler", fields: [handledById], references: [id])
  direction   CallDirection @default(OUTBOUND)
  outcome     CallOutcome?
  duration    Int? // seconds
  notes       String?
  calledAt    DateTime      @default(now())

  @@index([branchId])
  @@map("calls")
}

// --- Trial Management ---
model Trial {
  id        String      @id @default(uuid())
  branchId  String
  branch    Branch      @relation(fields: [branchId], references: [id])
  leadId    String
  lead      Lead        @relation(fields: [leadId], references: [id])
  scheduledAt DateTime
  status    TrialStatus @default(SCHEDULED)
  feedback  String?
  createdAt DateTime    @default(now())

  @@index([branchId])
  @@map("trials")
}

// --- Sports Management ---
model SportsProgram {
  id          String   @id @default(uuid())
  name        String
  description String?
  coachName   String?
  createdAt   DateTime @default(now())

  @@map("sports_programs")
}

// --- Therapy Management ---
model TherapyProgram {
  id           String   @id @default(uuid())
  name         String
  description  String?
  therapistName String?
  createdAt    DateTime @default(now())

  @@map("therapy_programs")
}

// --- Payroll ---
model PayrollEntry {
  id          String   @id @default(uuid())
  staffId     String
  staff       Staff    @relation(fields: [staffId], references: [id])
  month       Int
  year        Int
  baseSalary  Decimal  @db.Decimal(12, 2)
  deductions  Decimal  @default(0) @db.Decimal(12, 2)
  bonuses     Decimal  @default(0) @db.Decimal(12, 2)
  netPay      Decimal  @db.Decimal(12, 2)
  paidAt      DateTime?
  createdAt   DateTime @default(now())

  @@unique([staffId, month, year])
  @@map("payroll_entries")
}

// --- Finance / General Ledger ---
model LedgerEntry {
  id          String          @id @default(uuid())
  branchId    String
  branch      Branch          @relation(fields: [branchId], references: [id])
  account     String
  type        LedgerEntryType
  amount      Decimal         @db.Decimal(12, 2)
  description String?
  entryDate   DateTime        @default(now())
  createdAt   DateTime        @default(now())

  @@index([branchId])
  @@map("ledger_entries")
}

// --- Expense Tracker ---
model Expense {
  id          String        @id @default(uuid())
  branchId    String
  branch      Branch        @relation(fields: [branchId], references: [id])
  category    String
  amount      Decimal       @db.Decimal(12, 2)
  description String?
  status      ExpenseStatus @default(PENDING)
  incurredAt  DateTime      @default(now())
  createdAt   DateTime      @default(now())

  @@index([branchId])
  @@map("expenses")
}

// --- Inventory ---
model InventoryItem {
  id        String   @id @default(uuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  name      String
  sku       String?
  quantity  Int      @default(0)
  unit      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions InventoryTransaction[]

  @@index([branchId])
  @@map("inventory_items")
}

model InventoryTransaction {
  id        String           @id @default(uuid())
  itemId    String
  item      InventoryItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type      InventoryTxnType
  quantity  Int
  notes     String?
  createdAt DateTime         @default(now())

  @@map("inventory_transactions")
}

// --- Marketing CRM ---
model Campaign {
  id        String   @id @default(uuid())
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  name      String
  channel   String?
  budget    Decimal? @db.Decimal(12, 2)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime @default(now())

  @@map("campaigns")
}

// --- Events ---
model Event {
  id          String      @id @default(uuid())
  branchId    String?
  branch      Branch?     @relation(fields: [branchId], references: [id])
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime?
  status      EventStatus @default(PLANNED)
  createdAt   DateTime    @default(now())

  @@map("events")
}

// --- Notifications Center ---
model Notification {
  id          String              @id @default(uuid())
  branchId    String?
  branch      Branch?             @relation(fields: [branchId], references: [id])
  recipientId String?
  recipient   User?               @relation("NotificationRecipient", fields: [recipientId], references: [id])
  channel     NotificationChannel @default(IN_APP)
  title       String
  body        String?
  status      NotificationStatus  @default(QUEUED)
  sentAt      DateTime?
  createdAt   DateTime            @default(now())

  @@map("notifications")
}

// --- Documents ---
model Document {
  id          String         @id @default(uuid())
  branchId    String?
  branch      Branch?        @relation(fields: [branchId], references: [id])
  childId     String?
  child       Child?         @relation(fields: [childId], references: [id])
  admissionId String?
  admission   Admission?     @relation(fields: [admissionId], references: [id])
  fileName    String
  fileUrl     String
  mimeType    String?
  sizeBytes   Int?
  status      DocumentStatus @default(PENDING)
  uploadedAt  DateTime       @default(now())

  @@map("documents")
}

// --- Calendar (generic event placeholder, distinct from Events module) ---
model CalendarEntry {
  id        String   @id @default(uuid())
  title     String
  startAt   DateTime
  endAt     DateTime?
  ownerId   String?
  notes     String?
  createdAt DateTime @default(now())

  @@map("calendar_entries")
}
